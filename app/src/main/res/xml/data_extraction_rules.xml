<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Keystore-bound encrypted preferences must never be transferred to another hardware device -->
        <exclude domain="sharedpref" path="reel_library_vault_encrypted.xml" />
        <exclude domain="sharedpref" path="reelrecall_secure_keys.xml" />
        <exclude domain="sharedpref" path="reel_library_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
